# Worker-only values. Copy to .dev.vars for local development.
# Never add VITE_ prefixes to credentials.
TELEGRAM_BOT_TOKEN=replace_with_botfather_token
OWNER_TELEGRAM_ID=replace_with_your_numeric_telegram_user_id
TELEGRAM_WEBHOOK_SECRET=replace_with_random_32_plus_character_secret
MINI_APP_URL=https://replace-with-your-worker.workers.dev
