# Worker-only values. Copy to .dev.vars for local development.
# Never add VITE_ prefixes to credentials.
TELEGRAM_BOT_TOKEN=replace_with_botfather_token
OWNER_TELEGRAM_ID=replace_with_your_numeric_telegram_user_id
TELEGRAM_WEBHOOK_SECRET=replace_with_random_32_plus_character_secret
MINI_APP_URL=https://replace-with-your-worker.workers.dev

# Worker-only controller secret; use a distinct cryptographically random secret.
CLI_AUTH_SECRET=replace_with_random_64_character_hex_secret
CLI_ALLOWED_ACTIONS=read
# Enable only after production migration and test-channel approval.
SCHEDULER_ENABLED=false

# Python process variables (not frontend variables). Export them securely.
K9_API_URL=https://k9-pb.kimshikano.workers.dev
K9_CLI_SECRET=replace_with_the_same_worker_cli_auth_secret

# Phase 3.1 Python bot (.env), not frontend variables.
# BOT_TOKEN/OWNER_ID must match the existing Worker bot and owner.
BOT_TOKEN=replace_with_existing_botfather_token
OWNER_ID=replace_with_your_numeric_telegram_user_id
WEB_APP_URL=https://k9-pb.kimshikano.workers.dev/
API_BASE_URL=https://k9-pb.kimshikano.workers.dev
# Preference only: an existing webhook is switched only with explicit confirmation.
BOT_RUNTIME_MODE=python

# Same separate encrypted K9_BRIDGE_SECRET on Worker and private Python .env.
# Preserve CLI_AUTH_SECRET; do not replace it with this secret.
K9_BRIDGE_SECRET=replace_with_separate_random_64_character_hex_secret
# Worker-only scope list; grant writes/runtime explicitly after review.
K9_BRIDGE_ALLOWED_ACTIONS=read
